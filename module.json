    "JournalEntryPage": {
      "lostMap": {
        "htmlFields": ["text"],
        "filePathFields": {
          "mapImage": ["IMAGE"]
        }
      },
      "lostMapResult": {
        "htmlFields": ["text"],
        "filePathFields": {
          "mapImage": ["IMAGE"]
        }
      }
    }
  }
