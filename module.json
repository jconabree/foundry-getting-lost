{
  "id": "foundry-getting-lost",
  "title": "Getting Lost Helper",
  "description": "Foundry VTT Module",
  "version": "#{VERSION}#",
  "library": false,
  "compatibility": {
    "minimum": 13,
    "verified": 14,
    "maximum": 14
  },
  "authors": [
    {
      "name": "Justin Conabree",
      "url": "https://github.com/jconabree"
    }
  ],
  "relationships": {
    "systems": [],
    "requires": []
  },
  "esmodules": ["dist/scripts/module.js"],
  "scripts": [],
  "styles": ["dist/styles/module.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "dist/languages/en.json"
    }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "license": "LICENSE",
  "readme": "README.md",
  "media": [
    {
      "type": "icon",
      "url": "https://raw.githubusercontent.com/jconabree/foundry-getting-lost/refs/heads/main/icons/logo.png"
    }
  ],
