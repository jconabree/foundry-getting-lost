{
  "name": "foundry-getting-lost",
  "version": "#{VERSION}#",
  "description": "Foundry VTT Module",
  "repository": {
    "type": "git",
    "url": "git@github.com:jconabree/foundry-getting-lost.git"
  },
  "keywords": [
    "Foundry VTT",
    "WLED"
  ],
  "author": "Justin Conabree",
  "license": "SEE LICENSE",
  "bugs": {
    "url": "https://github.com/jconabree/foundry-getting-lost/issues"
  },
  "homepage": "https://github.com/jconabree/foundry-getting-lost#readme",
  "main": "dist/module.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:all": "npm run clean && npm run build:scripts && npm run build:static",
    "build:scripts": "tsc",
    "build:static": "node copyStatic.mjs",
    "build:languages": "cp -r src/languages dist/",
    "watch:all": "concurrently \"npm run watch:scripts\" \"npm run watch:static\"",
    "watch:scripts": "tsc --watch",
    "watch:static": "nodemon -L --watch 'src/*' --ignore src/scripts/ -e css,js,json,html,hbs --exec 'node copyStatic.mjs'",
    "clean": "rimraf ./dist/*",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:json": "node -e \"for (const f of process.argv.slice(1)) JSON.parse(require('fs').readFileSync(f, 'utf8'))\" module.json src/languages/en.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run check:json && npm run typecheck"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@inquirer/prompts": "^7.2.1",
    "@league-of-foundry-developers/fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#3fe9f727b885ed8b16b9943ac53553134eb95f65",
    "chalk": "^5.4.1",
    "concurrently": "^9.1.2",
    "eslint": "9.39.5",
    "git-url-parse": "^16.0.0",
    "globals": "17.13.0",
    "globby": "^14.0.2",
    "nodemon": "^3.1.9",
    "prettier": "3.9.10",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.0"
  },
  "engines": {
    "node": ">=24"
  }
}
